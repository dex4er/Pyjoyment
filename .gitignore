# The parts of https://www.toptal.com/developers/gitignore/api/python,node,macos,visualstudiocode
# that apply here; a path is anchored where it could match a directory of the
# project, as "lib/" of the template would match t/lib. hatchling builds the
# packages without the files that this file ignores.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
/build/
/dist/

# Virtual environments of uv, of the tests of the servers and of the benchmarks
.venv
.venv-*
benchmarks/venv/

# Caches of the tools
.ruff_cache/

# The working directories of OpenTofu, with the archives of the functions, the locks
# of the providers, which are not locked, the states and the variables of each one
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars

# The ZIP files of the functions that "generate lambda-zip" writes for OpenTofu
examples/*/function/dist/

# Logs, as the one of TF_LOG_PATH of OpenTofu
*.log

# The packages of npm, which npm run bundle copies from
node_modules/
npm-debug.log*

# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/

# Secrets, as in the rules of .claude/settings.json
.env
.env.*
.envrc
.pypirc
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
# The key of the default certificate for TLS servers, like in Mojo
!/Pyjo/IOLoop/certs/server.key
# Certificates of the tests, like t/mojo/certs in Mojo
!/t/certs/*.key
