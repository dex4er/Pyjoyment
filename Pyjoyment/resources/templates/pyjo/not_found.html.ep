%# Renamed from Mojolicious: the image of the unicat is pyjo/nounicat.png, where Mojo has mojo/noraptor.png, and its
%# element is #nounicat, where Mojo has #noraptor
<!DOCTYPE html>
<!-- Request ID: <%= c.req.request_id %> -->
<html>
  <head>
    <title>Page Not Found</title>
    <style>
      a img {
        border: 0;
      }
      body {
        background-color: #caecf6;
      }
      #nounicat {
        left: 0%;
        position: fixed;
        top: 60%;
      }
      #notfound {
        background: url(<%= url_for_file('/pyjo/notfound.png') %>);
        height: 62px;
        left: 50%;
        margin-left: -153px;
        margin-top: -31px;
        position:absolute;
        top: 50%;
        width: 306px;
      }
    </style>
    %= favicon()
  </head>
  <body>
    %= link_to(url_for().base, begin
      %= image('/pyjo/nounicat.png', alt='Bye!', id='nounicat')
    % end)
    <div id="notfound"></div>
  </body>
</html>
<!-- a padding to disable MSIE and Chrome friendly error page -->
