% import importlib.metadata, os, platform, sys, time
%# Renamed from Mojolicious: the files of the page are in pyjo/, where Mojo has them in mojo/, its stylesheet is
%# pyjo/pyjo.css, where Mojo has mojo/mojo.css, and the language of highlight.js for templates is pyjoyment, where Mojo
%# has mojolicious; the links of the page are those of Pyjoyment
<!DOCTYPE html>
<!-- Request ID: <%= c.req.request_id %> -->
<html>
  <head>
    % title = 'Server Error' if stash('exception') else 'Page Not Found'
    <title><%= title %> (<%= app().mode %> mode)</title>
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="-1">
    %= favicon()
    %= javascript('/pyjo/highlight.js/highlight.min.js')
    %= javascript('/pyjo/highlight.js/pyjoyment.min.js')
    %# Left out from Mojolicious: popper.js, as bootstrap.js is the bundle of Bootstrap, which has Popper
    %= javascript('/pyjo/bootstrap/bootstrap.js')
    %= stylesheet('/pyjo/bootstrap/bootstrap.css')
    %= stylesheet('/pyjo/highlight.js/highlight-mojo-dark.css')
    %= stylesheet('/pyjo/pyjo.css')
    <script>
      'use strict';
      %# Unlike Mojolicious: highlightAll of highlight.js 11, where Mojo calls initHighlightingOnLoad of highlight.js 10,
      %# which highlight.js 11 deprecates
      hljs.highlightAll();
      window.addEventListener('load', () => {
        for (const tooltip of document.querySelectorAll('[data-bs-toggle="tooltip"]')) {
          new bootstrap.Tooltip(tooltip);
        }
      });
    </script>
    <style>
      .social-icon {
        width: 32px;
        display: inline-block;
        line-height: 24px;
      }
    </style>
  </head>
  <body class="d-flex flex-column h-100">
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark mojobar">
        <a href="https://pyjoyment.readthedocs.io/" id="mojobar-brand" class="navbar-brand">
          <picture>
            <img src="<%= url_for_file('/pyjo/logo-white.png') %>"
              srcset="<%= url_for_file('/pyjo/logo-white-2x.png') %> 2x">
          </picture>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
          aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div id="navbarNav" class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
                aria-haspopup="true" aria-expanded="false">
                Documentation
              </a>
              <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/">Overview</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/en/latest/intro.html">Introduction</a>
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/en/latest/status.html">Status</a>
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/en/latest/installation.html">Installation</a>
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/en/latest/examples.html">Examples</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="https://pyjoyment.readthedocs.io/en/latest/api/index.html">API</a>
              </div>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="communityDropdown" role="button" data-bs-toggle="dropdown"
                aria-haspopup="true" aria-expanded="false">
                Community
              </a>
              <div class="dropdown-menu" aria-labelledby="communityDropdown">
                <a class="dropdown-item" href="https://github.com/dex4er/Pyjoyment/issues">Issues</a>
                <a class="dropdown-item" href="https://pypi.org/project/Pyjoyment/">PyPI</a>
                <a class="dropdown-item" href="https://mojolicious.org">Mojolicious</a>
              </div>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="https://github.com/dex4er/Pyjoyment/">Contribute on GitHub</a>
            </li>
          </ul>
          %# Left out from Mojolicious: the form of the search, as it searches the documentation of Mojolicious
        </div>
      </nav>
    </header>
    <script>
      'use strict';
      function mojoDrawer(handle, drawer) {
        const handleEl = document.querySelector(handle);
        if (handleEl === null) return;
        handleEl.addEventListener('click', () => {
          const drawerEl = document.querySelector(drawer);
          let text = handleEl.innerText;
          text = text == "tap for more" ? "tap for less" : "tap for more";
          const divTap = document.querySelector(handle + ' div.tap');
          if (divTap !== null) divTap.innerText = text;
          drawerEl.classList.toggle('d-none');
        });
      }
      window.addEventListener('load', () => {
        mojoDrawer('#trace', '#frames');
        mojoDrawer('#more', '#infos');
      });
    </script>
    <div class="container flex-grow-1">
      <div class="row flex-wrap">
        <main class="col-sm-12 col-md-8 col-lg-10 py-md-3 pl-md-5">
          <div class="row mojo-divider">
            % kv = begin
              % key, value = args
              <tr>
                <td class="key text-right"><%= key %>:</td>
                <td class="value"><pre><%= value %></pre></td>
              </tr>
            % end
            % if (exception := stash('exception')) {
              <div class="alert alert-danger wide" role="alert">
                <h2>Server Error</h2>
                This application is in <b>development</b> mode and will show internal information to help you with
                debugging.
              </div>
              % cv = begin
                % key, value, i = [*args, None][:3]
                %= tag('tr', begin
                  <td class="text-right"><%= key %></td>
                  <td class="context-value wide">
                    <pre><code><%= value %></code></pre>
                  </td>
                %= end, **({'class': 'important'} if i else {}))
              % end
              <div id="showcase" class="box code no-bottom-border no-top-border border-radius-top">
                <pre id="error" class="error"><%= exception.message %></pre>
                <div id="context" class="more">
                  <table class="wide">
                    % for line in exception.lines_before {
                      %= cv(line[0], line[1])
                    % }
                    % if len(exception.line) > 1 {
                      %= cv(exception.line[0], exception.line[1], 1)
                    % }
                    % for line in exception.lines_after {
                      %= cv(line[0], line[1])
                    % }
                  </table>
                </div>
                % if len(exception.line) > 2 {
                  <div id="insight">
                    <table class="wide">
                      % for line in exception.lines_before {
                        %= cv(line[0], line[2])
                      % }
                      %= cv(exception.line[0], exception.line[2], 1)
                      % for line in exception.lines_after {
                        %= cv(line[0], line[2])
                      % }
                    </table>
                  </div>
                  <div class="tap">tap for more</div>
                  <script>
                    'use strict';
                    let current = '#context';
                    function mojoShowcase() {
                      const showcase = document.querySelector('#showcase');
                      function onClickShowcase() {
                        showcase.removeEventListener('click', onClickShowcase);
                        let currentEl = document.querySelector(current);
                        currentEl.classList.toggle('d-none');
                        current = current == '#context' ? '#insight' : '#context';
                        currentEl = document.querySelector(current);
                        currentEl.classList.toggle('d-none');
                        mojoShowcase();
                      };
                      showcase.addEventListener('click', onClickShowcase);
                    }
                    mojoShowcase();
                    const insightEl = document.querySelector('#insight');
                    insightEl.classList.toggle('d-none');
                  </script>
                % }
              </div>
              <div id="trace" class="box no-padding more no-top-border border-radius-bottom">
                % if exception.frames {
                  <div id="frames" class="d-none">
                    <table class="striped wide">
                      % for frame in exception.frames {
                        <tr>
                          <td class="value">
                            <pre>File "<%= frame.filename %>", line <%= frame.lineno %>, in "<%= frame.name %>"</pre>
                          </td>
                        </tr>
                      % }
                    </table>
                  </div>
                  <div class="tap">tap for more</div>
                % }
              </div>
            % }
            % else {
              <div class="alert alert-warning wide" role="alert">
                <h2>Page Not Found</h2>
                This application is in <b>development</b> mode and will show internal information to help you with
                debugging.
              </div>
              <div id="routes" class="box no-padding border-radius-both">
                <div class="padded-content">
                  <p>
                    None of these routes could generate a response for your
                    <code><%= c.req.method %></code> request for
                    <code><%= c.req.url.path.to_route() %></code>, maybe you need
                    to add a new one?
                  </p>
                </div>
                % walk = begin
                  % walk, route, depth = args
                  % pattern = route.pattern
                  % unparsed = pattern.unparsed or '/'
                  % unparsed = f'+{unparsed}' if depth else unparsed
                  % pattern.match('/', route.is_endpoint and not route.partial)
                  % regex = pattern.regex.pattern
                  <tr data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true"
                    data-bs-title="<b>Regex:</b> <code><%= regex %></code>">
                    <td class="value">
                      <pre><%= '  ' * depth %><%= unparsed %></pre>
                    </td>
                    <td class="value">
                      <pre><%= ','.join(route.methods() or []).upper() or '*' %></pre>
                    </td>
                    <td class="value">
                      % name = route.name
                      %# Unlike Mojolicious: the badge has the classes text-bg-success and text-bg-secondary of
                      %# Bootstrap 5, where Mojo has badge-success and badge-secondary of Bootstrap 4, which its
                      %# Bootstrap 5 has not, so that Mojo shows the name white on white
                      % badge = 'text-bg-success' if route.has_custom_name else 'text-bg-secondary'
                      <span class="badge <%= badge %>"><%= name %></span>
                    </td>
                  </tr>
                  % depth += 1
                  % for child in route.children {
                    %= walk(walk, child, depth)
                  % }
                  % depth -= 1
                % end
                <table class="striped-grey wide">
                  <thead>
                    <tr>
                      <th>Pattern</th>
                      <th>Methods</th>
                      <th>Name</th>
                    </tr>
                  </thead>
                  % for child in app().routes.children {
                    %= walk(walk, child, 0)
                  % }
                </table>
              </div>
            % }
          </div>
          <div class="row mojo-divider">
            <div id="request" class="box no-padding no-bottom-border border-radius-top">
              <table class="striped fixed-table wide">
                % req = c.req
                %= kv('Request ID', req.request_id)
                %= kv('Method', req.method)
                % url = req.url
                %= kv('URL', url.to_str())
                %= kv('Base URL', url.base.to_str())
                %= kv('Parameters', dumper(req.params.to_dict()))
                %= kv('Stash', dumper(snapshot))
                %= kv('Session', dumper(session()))
                %= kv('Version', req.version)
                % for name in sorted(c.req.headers.names()) {
                  % value = c.req.headers.header(name)
                  %= kv(name, value)
                % }
              </table>
            </div>
            <div id="more" class="box no-padding more no-top-border border-radius-bottom">
              <div id="infos" class="d-none">
                <table class="striped fixed-table wide">
                  %= kv('Python', f'{platform.python_implementation()} {platform.python_version()} ({sys.platform})')
                  % try {
                    % version = importlib.metadata.version('Pyjoyment')
                  % } except importlib.metadata.PackageNotFoundError {
                    % version = 'not installed'
                  % }
                  %# Left out from Mojolicious: the codename, as Pyjoyment has none
                  %= kv('Pyjoyment', version)
                  %= kv('Home', app().home)
                  %= kv('Template paths', dumper(app().renderer.paths))
                  %= kv('Template classes', dumper(app().renderer.classes))
                  %= kv('Static paths', dumper(app().static.paths))
                  %= kv('Static classes', dumper(app().static.classes))
                  %= kv('Include', dumper(sys.path))
                  %= kv('Config', dumper(app().config()))
                  %= kv('Moniker', app().moniker)
                  %= kv('Name', sys.argv[0])
                  %= kv('Executable', sys.executable)
                  %= kv('PID', os.getpid())
                  %= kv('Time', time.ctime())
                </table>
              </div>
              <div class="tap tap-border-top">tap for more</div>
            </div>
          </div>
          <div class="row">
            % if app().log.history {
                % log = ''.join(app().log.format(*entry) for entry in app().log.history)
                <pre class="mojo-terminal"><code class="nohighlight"><%= log %></code></pre>
            % }
            % else {
              <div class="alert alert-warning wide" role="alert">
                The application log appears to be empty, perhaps the log level <b><%= app().log.level %></b> is too
                high?
              </div>
            % }
          </div>
        </main>
      </div>
    </div>
    <footer>
      <div class="container-fluid p-3 mojo-footer">
        <div class="row">
          <div class="col-sm align-self-center text-center mojo-free">
            <b>Free</b> and <b>Open Source</b>.
          </div>
          <div class="col-sm align-self-center text-center mojo-copy">
              &copy; 2014-2026 Piotr Roszatycki, based on
              <a href="https://mojolicious.org">Mojolicious</a> &copy; 2008-2025 Sebastian Riedel and the
              <a href="https://docs.mojolicious.org/Mojolicious#AUTHORS">Mojolicious contributors</a>.
          </div>
          <div class="col-sm align-self-center text-center mojo-social">
            %# The icon of GitHub is mark-github of Octicons, under the MIT License, https://github.com/primer/octicons
            <a alt="GitHub" href="https://github.com/dex4er/Pyjoyment" class="social-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="height: 23px;"><path fill="currentColor" d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"/></svg>
            </a>
            %# Left out from Mojolicious: the links of Mastodon and LinkedIn, where Pyjoyment has no profiles
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
